# Fill real credentials only in the ignored local .env file.
COOL_BASE_URL=https://cool.ntu.edu.tw
COOL_USERNAME=
COOL_PASSWORD=
# Required: comma-separated course IDs from /courses/<id> URLs.
COOL_COURSE_IDS=
CHECK_INTERVAL_SECONDS=600
BROWSER_HEADLESS=true
AUTH_STATE_PATH=playwright/.auth/state.json
DATA_DIR=data
DATABASE_PATH=data/state.sqlite3
# Choose a model service during implementation.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
TZ=Asia/Taipei
