# Fill real credentials only in the ignored local .env file.
COOL_BASE_URL=https://cool.ntu.edu.tw
COOL_USERNAME=
COOL_PASSWORD=
# All student courses, or Canvas internal IDs from /courses/<id> URLs (not academic course codes).
COOL_COURSE_IDS=all
CHECK_INTERVAL_SECONDS=600
BROWSER_HEADLESS=true
AUTH_STATE_PATH=playwright/.auth/state.json
DATA_DIR=data
DATABASE_PATH=data/state.sqlite3
# Uses the locally installed Codex CLI and its existing login (codex login).
LLM_MODEL=gpt-6.1-sol
TZ=Asia/Taipei
# Optional: answer attachments, course/submission location and problem notifications.
# Set the secret URL only in local .env. Blank disables Discord.
DISCORD_WEBHOOK_URL=
